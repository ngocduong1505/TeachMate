# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model chính và model dự phòng (khi bị 429)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Upstash Redis (https://console.upstash.com, free) - dùng cho rate limit + cache.
# Bỏ trống khi dev: sẽ dùng bộ nhớ tạm.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Giới hạn (tùy chọn)
RATE_LIMIT_PER_DAY=10
GLOBAL_LIMIT_PER_DAY=200

# Supabase (https://supabase.com/dashboard) - lưu log sử dụng. Chạy supabase/usage_logs.sql trước.
# Publishable key chỉ được INSERT vào usage_logs (qua RLS), nên an toàn khi lộ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tên miền nội bộ cho tài khoản đăng ký bằng tên đăng nhập (không cần email thật), tùy chọn.
NEXT_PUBLIC_USERNAME_DOMAIN=
